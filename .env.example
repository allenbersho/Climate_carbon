# Application
PROJECT_NAME="CarbonTrack"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Bootstrap Seed
FIRST_ADMIN_EMAIL="admin@carbontrack.org"
FIRST_ADMIN_PASSWORD="AdminPassword123!"

# Database
# Default development / local fallback (SQLite):
DATABASE_URL="sqlite:///./carbontrack.db"
# PostgreSQL configuration for Docker or local PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/carbontrack"
